<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bons Burguer | ¡Sabor y Diversión Animatrónica!</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Creepster & Inter & Press Start 2P -->
    <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Inter:wght@300;400;600;800;900&family=Press+Start+2P&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        neonPurple: '#9333ea',
                        neonBlue: '#06b6d4',
                        neonYellow: '#facc15',
                        darkBg: '#09090b',
                        cardBg: '#18181b',
                    },
                    fontFamily: {
                        creepster: ['Creepster', 'cursive'],
                        arcade: ['"Press Start 2P"', 'monospace'],
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        @keyframes neonFlicker {
            0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% {
                text-shadow: 0 0 4px #fff, 0 0 11px #fff, 0 0 19px #fff, 0 0 40px #9333ea, 0 0 80px #9333ea, 0 0 90px #9333ea;
            }
            20%, 24%, 55% {
                text-shadow: none;
            }
        }
        
        @keyframes boxNeonFlicker {
            0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% {
                box-shadow: 0 0 15px rgba(147, 51, 234, 0.6), inset 0 0 15px rgba(6, 182, 212, 0.4);
            }
            20%, 24%, 55% {
                box-shadow: none;
            }
        }

        .neon-title {
            animation: neonFlicker 3s infinite alternate;
        }

        .neon-box {
            animation: boxNeonFlicker 4s infinite alternate;
        }

        .scanlines {
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.25) 50%
            ), linear-gradient(
                90deg,
                rgba(255, 0, 0, 0.03),
                rgba(0, 255, 0, 0.01),
                rgba(0, 0, 255, 0.03)
            );
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
        }

        .stage-lights {
            background: radial-gradient(circle at 50% 0%, rgba(147, 51, 234, 0.3) 0%, rgba(9, 9, 11, 0.95) 70%);
        }
    </style>
</head>
<body class="bg-darkBg text-gray-100 font-sans selection:bg-neonPurple selection:text-white overflow-x-hidden">

    <div class="fixed inset-0 scanlines z-50 pointer-events-none"></div>

    <header class="fixed top-0 left-0 right-0 z-40 bg-darkBg/90 backdrop-blur-md border-b border-neonPurple/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-full bg-neonPurple/20 border-2 border-neonBlue flex items-center justify-center neon-box group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-robot text-neonYellow text-xl"></i>
                </div>
                <span class="font-creepster text-2xl sm:text-3xl tracking-wider text-neonYellow neon-title">Bons Burguer</span>
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center space-x-8">
                <a href="#menu" class="text-sm font-semibold hover:text-neonBlue transition-colors">Menú</a>
                <a href="#animatronicos" class="text-sm font-semibold hover:text-neonPurple transition-colors">Animatrónicos</a>
                <a href="#arcade" class="text-sm font-semibold hover:text-neonYellow transition-colors">Zona Arcade</a>
                <a href="#horarios" class="text-sm font-semibold hover:text-neonBlue transition-colors">Horarios</a>
                <a href="#reservas" class="bg-neonPurple hover:bg-neonPurple/80 text-white px-5 py-2.5 rounded-xl font-bold shadow-lg shadow-neonPurple/30 transition-all hover:scale-105">Reservar Mesa</a>
            </nav>

            <!-- Mobile Menu Button -->
            <button id="menu-btn" class="md:hidden text-gray-300 hover:text-white text-2xl focus:outline-none">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <!-- Mobile Nav Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-cardBg border-b border-gray-800 px-4 pt-2 pb-6 space-y-3">
            <a href="#menu" class="block py-2 text-gray-300 hover:text-neonBlue">Menú</a>
            <a href="#animatronicos" class="block py-2 text-gray-300 hover:text-neonPurple">Animatrónicos</a>
            <a href="#arcade" class="block py-2 text-gray-300 hover:text-neonYellow">Zona Arcade</a>
            <a href="#horarios" class="block py-2 text-gray-300 hover:text-neonBlue">Horarios</a>
            <a href="#reservas" class="block text-center bg-neonPurple text-white py-3 rounded-xl font-bold mt-2 shadow-lg">Reservar Mesa</a>
        </div>
    </header>

    <section class="relative min-h-screen flex items-center justify-center stage-lights pt-20 px-4 overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#9333ea_1px,transparent_1px)] [background-size:16px_16px]"></div>
        
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10 py-16">
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                <div class="inline-flex items-center space-x-2 bg-neonPurple/10 border border-neonPurple/40 px-4 py-2 rounded-full">
                    <span class="w-2.5 h-2.5 rounded-full bg-neonYellow animate-ping"></span>
                    <span class="text-xs sm:text-sm font-arcade text-neonYellow">¡EL SHOW ESTÁ A PUNTO DE EMPEZAR!</span>
                </div>
                
                <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-none">
                    ¡Donde la carne es jugosa y <span class="text-neonPurple neon-title font-creepster tracking-wider">nuestros amigos</span> cobran vida!
                </h1>
                
                <p class="text-gray-400 text-lg sm:text-xl max-w-2xl mx-auto lg:mx-0">
                    Disfruta de las mejores hamburguesas de la ciudad mientras Bon the Bear y su banda interpretan sus grandes éxitos musicales bajo luces de neón parpadeantes.
                </p>
                
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
                    <a href="#menu" class="w-full sm:w-auto bg-neonBlue hover:bg-neonBlue/80 text-darkBg font-extrabold px-8 py-4 rounded-xl shadow-lg shadow-neonBlue/30 transition-all hover:scale-105 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-burger"></i>
                        <span>Ver Menú</span>
                    </a>
                    <a href="#reservas" class="w-full sm:w-auto border-2 border-neonYellow text-neonYellow hover:bg-neonYellow hover:text-darkBg font-bold px-8 py-4 rounded-xl transition-all hover:scale-105 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-calendar-days"></i>
                        <span>Reservar Mesa</span>
                    </a>
                </div>
            </div>

            <!-- Hero Interactive Card -->
            <div class="lg:col-span-5 flex justify-center">
                <div class="relative w-full max-w-md bg-cardBg border-2 border-neonPurple rounded-3xl p-6 neon-box shadow-2xl transform hover:rotate-1 transition-transform">
                    <div class="absolute -top-4 right-6 bg-neonYellow text-darkBg font-arcade text-xs px-3 py-1.5 rounded-full uppercase font-bold tracking-wider">
                        Estrella Principal
                    </div>
                    
                    <div class="relative h-72 rounded-2xl overflow-hidden bg-gradient-to-b from-purple-900/40 to-black border border-gray-800 flex items-center justify-center group">
                        <!-- Neon spotlight effect -->
                        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-neonBlue/30 via-transparent to-transparent"></div>
                        
                        <!-- Bear Character SVG illustration placeholder -->
                        <div class="text-center z-10 space-y-3 group-hover:scale-105 transition-transform duration-300">
                            <div class="w-32 h-32 mx-auto bg-amber-900/60 rounded-full border-4 border-neonYellow flex items-center justify-center shadow-inner relative">
                                <i class="fa-solid fa-bear text-neonYellow text-6xl"></i>
                                <div class="absolute top-2 right-2 w-3 h-3 bg-red-600 rounded-full animate-ping"></div>
                            </div>
                            <h3 class="font-creepster text-3xl text-neonYellow tracking-wide">Bon The Bear</h3>
                            <p class="text-xs font-arcade text-neonBlue">ESTADO: ACTIVO & CANTANDO</p>
                        </div>
                    </div>

                    <div class="mt-6 space-y-3">
                        <div class="flex justify-between text-sm text-gray-400">
                            <span>Nivel de Diversión:</span>
                            <span class="text-neonYellow font-bold">100% Máximo</span>
                        </div>
                        <div class="w-full bg-gray-800 h-2 rounded-full overflow-hidden">
                            <div class="bg-gradient-to-r from-neonBlue to-neonPurple h-full w-[95%] animate-pulse"></div>
                        </div>
                        <p class="text-xs text-gray-500 text-center italic pt-2">"¡Recuerda sonreír ante las cámaras!"</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="animatronicos" class="py-24 bg-darkBg relative border-t border-gray-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-neonPurple font-arcade text-xs tracking-widest uppercase">El Escenario Principal</span>
                <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight">Conoce a Nuestros <span class="text-neonYellow font-creepster">Animatrónicos</span></h2>
                <p class="text-gray-400">Nuestros artistas robóticos de última generación te harán pasar una noche inolvidable. ¡Acércate a saludarlos con precaución!</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Bon Card -->
                <div class="bg-cardBg border border-gray-800 hover:border-neonPurple rounded-3xl p-6 transition-all duration-300 hover:-translate-y-2 group shadow-xl">
                    <div class="h-60 rounded-2xl bg-purple-950/20 border border-gray-800 flex items-center justify-center relative overflow-hidden mb-6">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                        <div class="w-28 h-28 bg-amber-800/40 rounded-full border-2 border-neonPurple flex items-center justify-center group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-shield-cat text-neonPurple text-5xl"></i>
                        </div>
                        <span id="status-1" class="absolute top-4 left-4 bg-green-500/20 border border-green-500 text-green-400 text-xs font-arcade px-2.5 py-1 rounded-full">
                            ● ACTIVO
                        </span>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2 flex items-center justify-between">
                        <span>Bon the Bear</span>
                        <button onclick="toggleStatus('status-1', this)" class="text-xs text-gray-400 hover:text-neonYellow bg-gray-800 px-2 py-1 rounded">Cambiar Estado</button>
                    </h3>
                    <p class="text-gray-400 text-sm mb-4">El líder indiscutible del restaurante. Su voz ronca y su guitarra animada animan todas las fiestas de cumpleaños.</p>
                    <div class="flex items-center space-x-2 text-xs text-neonBlue font-arcade">
                        <i class="fa-solid fa-music"></i>
                        <span>Vocalista Principal</span>
                    </div>
                </div>

                <!-- Chica Card -->
                <div class="bg-cardBg border border-gray-800 hover:border-neonBlue rounded-3xl p-6 transition-all duration-300 hover:-translate-y-2 group shadow-xl">
                    <div class="h-60 rounded-2xl bg-cyan-950/20 border border-gray-800 flex items-center justify-center relative overflow-hidden mb-6">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                        <div class="w-28 h-28 bg-yellow-900/40 rounded-full border-2 border-neonBlue flex items-center justify-center group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-drum text-neonBlue text-5xl"></i>
                        </div>
                        <span id="status-2" class="absolute top-4 left-4 bg-green-500/20 border border-green-500 text-green-400 text-xs font-arcade px-2.5 py-1 rounded-full">
                            ● ACTIVO
                        </span>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2 flex items-center justify-between">
                        <span>Chica Chicken</span>
                        <button onclick="toggleStatus('status-2', this)" class="text-xs text-gray-400 hover:text-neonYellow bg-gray-800 px-2 py-1 rounded">Cambiar Estado</button>
                    </h3>
                    <p class="text-gray-400 text-sm mb-4">La baterista más enérgica del local. Amante absoluta de los nuggets de pollo crujientes y los solos de batería infernales.</p>
                    <div class="flex items-center space-x-2 text-xs text-neonYellow font-arcade">
                        <i class="fa-solid fa-bolt"></i>
                        <span>Baterista Rockera</span>
                    </div>
                </div>

                <!-- Foxy Card -->
                <div class="bg-cardBg border border-gray-800 hover:border-neonYellow rounded-3xl p-6 transition-all duration-300 hover:-translate-y-2 group shadow-xl">
                    <div class="h-60 rounded-2xl bg-red-950/20 border border-gray-800 flex items-center justify-center relative overflow-hidden mb-6">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                        <div class="w-28 h-28 bg-red-900/40 rounded-full border-2 border-neonYellow flex items-center justify-center group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-skull-crossbones text-neonYellow text-5xl"></i>
                        </div>
                        <span id="status-3" class="absolute top-4 left-4 bg-yellow-500/20 border border-yellow-500 text-yellow-400 text-xs font-arcade px-2.5 py-1 rounded-full">
                            ⚠ EN MANTENIMIENTO
                        </span>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2 flex items-center justify-between">
                        <span>Foxy Fox</span>
                        <button onclick="toggleStatus('status-3', this)" class="text-xs text-gray-400 hover:text-neonYellow bg-gray-800 px-2 py-1 rounded">Cambiar Estado</button>
                    </h3>
                    <p class="text-gray-400 text-sm mb-4">Oculto en su rincón pirata junto a las máquinas recreativas. ¡Cuidado si le ves correr por pasillos oscuros!</p>
                    <div class="flex items-center space-x-2 text-xs text-red-400 font-arcade">
                        <i class="fa-solid fa-compass"></i>
                        <span>Pirata de Rincón</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="menu" class="py-24 bg-cardBg relative border-t border-gray-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-neonBlue font-arcade text-xs tracking-widest uppercase">Cocina Deliciosa y Misteriosa</span>
                <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight">Menú <span class="text-neonBlue neon-title font-creepster">Animatrónico</span></h2>
                <p class="text-gray-400">Preparadas con carne 100% seleccionada y un toque secreto que te dejará con la boca abierta.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Item 1 -->
                <div class="bg-darkBg border border-gray-800 rounded-2xl p-5 hover:border-neonPurple transition-all flex flex-col justify-between">
                    <div>
                        <div class="h-40 rounded-xl bg-purple-950/20 flex items-center justify-center mb-4 relative overflow-hidden border border-gray-800">
                            <i class="fa-solid fa-burger text-neonPurple text-5xl"></i>
                            <span class="absolute top-2 right-2 bg-neonPurple text-white text-xs px-2 py-0.5 rounded font-bold">12.99 €</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-1">La Hamburguesa Animatrónica</h3>
                        <p class="text-gray-400 text-xs mb-4">Doble carne de vacuno, triple cheddar fundido, tocino crujiente y salsa secreta de la casa con un toque ahumado.</p>
                    </div>
                    <button onclick="orderItem('La Hamburguesa Animatrónica')" class="w-full bg-neonPurple/20 hover:bg-neonPurple text-neonPurple hover:text-white border border-neonPurple text-xs font-bold py-2.5 rounded-xl transition-colors">
                        Pedir Ahora
                    </button>
                </div>

                <!-- Item 2 -->
                <div class="bg-darkBg border border-gray-800 rounded-2xl p-5 hover:border-neonBlue transition-all flex flex-col justify-between">
                    <div>
                        <div class="h-40 rounded-xl bg-cyan-950/20 flex items-center justify-center mb-4 relative overflow-hidden border border-gray-800">
                            <i class="fa-solid fa-cheese text-neonBlue text-5xl"></i>
                            <span class="absolute top-2 right-2 bg-neonBlue text-darkBg text-xs px-2 py-0.5 rounded font-extrabold">9.99 €</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-1">Doble Queso Neón</h3>
                        <p class="text-gray-400 text-xs mb-4">Queso gouda y cheddar que brillan con sabor, cebolla caramelizada, pepinillos crujientes y pan brioche artesanal.</p>
                    </div>
                    <button onclick="orderItem('Doble Queso Neón')" class="w-full bg-neonBlue/20 hover:bg-neonBlue text-neonBlue hover:text-darkBg border border-neonBlue text-xs font-bold py-2.5 rounded-xl transition-colors">
                        Pedir Ahora
                    </button>
                </div>

                <!-- Item 3 -->
                <div class="bg-darkBg border border-gray-800 rounded-2xl p-5 hover:border-neonYellow transition-all flex flex-col justify-between">
                    <div>
                        <div class="h-40 rounded-xl bg-yellow-950/20 flex items-center justify-center mb-4 relative overflow-hidden border border-gray-800">
                            <i class="fa-solid fa-fire text-neonYellow text-5xl"></i>
                            <span class="absolute top-2 right-2 bg-neonYellow text-darkBg text-xs px-2 py-0.5 rounded font-extrabold">14.50 €</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-1">Furia Carnívora</h3>
                        <p class="text-gray-400 text-xs mb-4">Para estómagos valientes: 3 carnes, pulled pork picante, aros de cebolla rebozados y salsa barbacoa infernal.</p>
                    </div>
                    <button onclick="orderItem('Furia Carnívora')" class="w-full bg-neonYellow/20 hover:bg-neonYellow text-neonYellow hover:text-darkBg border border-neonYellow text-xs font-bold py-2.5 rounded-xl transition-colors">
                        Pedir Ahora
                    </button>
                </div>

                <!-- Item 4 -->
                <div class="bg-darkBg border border-gray-800 rounded-2xl p-5 hover:border-red-500 transition-all flex flex-col justify-between">
                    <div>
                        <div class="h-40 rounded-xl bg-red-950/20 flex items-center justify-center mb-4 relative overflow-hidden border border-gray-800">
                            <i class="fa-solid fa-drumstick-bite text-red-500 text-5xl"></i>
                            <span class="absolute top-2 right-2 bg-red-600 text-white text-xs px-2 py-0.5 rounded font-bold">7.50 €</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-1">Nuggets del Terror</h3>
                        <p class="text-gray-400 text-xs mb-4">8 piezas de pollo 100% crujiente acompañadas de salsa agridulce especial o dip de queso picante.</p>
                    </div>
                    <button onclick="orderItem('Nuggets del Terror')" class="w-full bg-red-500/20 hover:bg-red-600 text-red-400 hover:text-white border border-red-500 text-xs font-bold py-2.5 rounded-xl transition-colors">
                        Pedir Ahora
                    </button>
                </div>
            </div>
        </div>
    </section>

    <section id="arcade" class="py-24 bg-darkBg relative border-t border-gray-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div class="space-y-6">
                    <span class="text-neonYellow font-arcade text-xs tracking-widest uppercase">Diversión Sin Límite</span>
                    <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight">Zona Arcade & <span class="text-neonYellow font-creepster">Entretenimiento</span></h2>
                    <p class="text-gray-400 text-base">
                        Mientras esperas tu pedido o después de cenar, diviértete en nuestra zona retro inspirada en los salones recreativos clásicos de los 80. ¡Gana tickets y cámbialos por premios exclusivos de Bons!
                    </p>
                    
                    <div class="space-y-4">
                        <div class="flex items-start space-x-4 bg-cardBg border border-gray-800 p-4 rounded-xl">
                            <div class="bg-neonPurple/20 text-neonPurple p-3 rounded-lg"><i class="fa-solid fa-gamepad text-xl"></i></div>
                            <div>
                                <h4 class="font-bold text-white">Pinballs Clásicos & Arcade Máquinas</h4>
                                <p class="text-xs text-gray-400">Juegos de pelea, carreras y clásicos retro con partidas ilimitadas con tu ticket de consumo.</p>
                            </div>
                        </div>
                        <div class="flex items-start space-x-4 bg-cardBg border border-gray-800 p-4 rounded-xl">
                            <div class="bg-neonBlue/20 text-neonBlue p-3 rounded-lg"><i class="fa-solid fa-gift text-xl"></i></div>
                            <div>
                                <h4 class="font-bold text-white">Caza de Peluches de Bon</h4>
                                <p class="text-xs text-gray-400">Intenta atrapar el peluche oficial de Bon the Bear en nuestra garra mecánica de alta precisión.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Arcade Visual Box -->
                <div class="bg-cardBg border-2 border-neonYellow rounded-3xl p-8 neon-box relative overflow-hidden">
                    <div class="absolute -right-10 -bottom-10 opacity-10">
                        <i class="fa-solid fa-arcade text-9xl text-neonYellow"></i>
                    </div>
                    <h3 class="font-arcade text-neonYellow text-lg mb-6 tracking-wide">ESTADÍSTICAS DEL SALÓN</h3>
                    <div class="grid grid-cols-2 gap-6 mb-8">
                        <div class="bg-darkBg p-4 rounded-xl border border-gray-800 text-center">
                            <span class="block text-3xl font-extrabold text-neonBlue font-arcade">24</span>
                            <span class="text-xs text-gray-400">Máquinas Recreativas</span>
                        </div>
                        <div class="bg-darkBg p-4 rounded-xl border border-gray-800 text-center">
                            <span class="block text-3xl font-extrabold text-neonPurple font-arcade">1.4k</span>
                            <span class="text-xs text-gray-400">Peluches Entregados</span>
                        </div>
                    </div>
                    <div class="bg-darkBg/80 p-4 rounded-xl border border-neonYellow/40 text-center">
                        <p class="text-xs text-neonYellow font-arcade">¡DISPONIBLE FICHAS GRATIS CON TU MENÚ INFANTIL!</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="horarios" class="py-24 bg-cardBg border-t border-gray-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="text-neonPurple font-arcade text-xs tracking-widest uppercase">¿CUÁNDO ABRIMOS?</span>
            <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight mt-2 mb-12">Horarios de <span class="text-neonPurple font-creepster">Apertura</span></h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
                <div class="bg-darkBg border border-gray-800 rounded-2xl p-6">
                    <i class="fa-solid fa-sun text-neonYellow text-3xl mb-4"></i>
                    <h3 class="font-bold text-white text-lg mb-2">Lunes a Jueves</h3>
                    <p class="text-neonBlue font-arcade text-sm">13:00 - 23:00 h</p>
                    <p class="text-xs text-gray-500 mt-2">Shows cada hora en punto</p>
                </div>
                <div class="bg-darkBg border border-neonPurple rounded-2xl p-6 shadow-lg shadow-neonPurple/20">
                    <i class="fa-solid fa-moon text-neonPurple text-3xl mb-4"></i>
                    <h3 class="font-bold text-white text-lg mb-2">Viernes y Sábados</h3>
                    <p class="text-neonYellow font-arcade text-sm">13:00 - 02:00 h</p>
                    <p class="text-xs text-gray-500 mt-2">¡Noche de concierto con Foxy & Bon!</p>
                </div>
                <div class="bg-darkBg border border-gray-800 rounded-2xl p-6">
                    <i class="fa-solid fa-utensils text-neonBlue text-3xl mb-4"></i>
                    <h3 class="font-bold text-white text-lg mb-2">Domingos y Festivos</h3>
                    <p class="text-neonBlue font-arcade text-sm">12:30 - 00:00 h</p>
                    <p class="text-xs text-gray-500 mt-2">Especial fiestas infantiles</p>
                </div>
            </div>
        </div>
    </section>

    <section id="reservas" class="py-24 bg-darkBg relative border-t border-gray-900 stage-lights">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="bg-cardBg border-2 border-neonPurple rounded-3xl p-8 sm:p-12 shadow-2xl neon-box">
                <div class="text-center space-y-3 mb-10">
                    <span class="text-neonYellow font-arcade text-xs tracking-widest uppercase">¡Reserva Tu Espacio!</span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold">Mesas & Fiestas de <span class="text-neonYellow font-creepster">Cumpleaños</span></h2>
                    <p class="text-gray-400 text-sm">Asegura tu sitio en primera fila frente al escenario principal o celebra tu cumpleaños junto a nuestros animatrónicos.</p>
                </div>

                <form id="reservation-form" onsubmit="handleReservation(event)" class="space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-arcade text-gray-300 mb-2">NOMBRE COMPLETO</label>
                            <input type="text" id="res-name" required class="w-full bg-darkBg border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neonPurple transition-colors" placeholder="Ej. Mike Schmidt">
                        </div>
                        <div>
                            <label class="block text-xs font-arcade text-gray-300 mb-2">CORREO ELECTRÓNICO</label>
                            <input type="email" id="res-email" required class="w-full bg-darkBg border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neonPurple transition-colors" placeholder="mike@freddy.com">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <div>
                            <label class="block text-xs font-arcade text-gray-300 mb-2">FECHA</label>
                            <input type="date" id="res-date" required class="w-full bg-darkBg border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neonPurple transition-colors">
                        </div>
                        <div>
                            <label class="block text-xs font-arcade text-gray-300 mb-2">HORA</label>
                            <select id="res-time" required class="w-full bg-darkBg border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neonPurple transition-colors">
                                <option value="13:00">13:00 h (Almuerzo)</option>
                                <option value="15:00">15:00 h (Tarde)</option>
                                <option value="18:00">18:00 h (Merienda)</option>
                                <option value="20:00">20:00 h (Cena Show)</option>
                                <option value="22:00">22:00 h (Nocturno)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-arcade text-gray-300 mb-2">TIPO DE RESERVA</label>
                            <select id="res-type" required class="w-full bg-darkBg border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neonPurple transition-colors">
                                <option value="Mesa Estándar">Mesa Frente al Escenario</option>
                                <option value="Fiesta Cumpleaños">Fiesta de Cumpleaños 🎉</option>
                                <option value="VIP Zona Arcade">Zona VIP Arcade</option>
                            </select>
                        </div>
                    </div>

                    <div class="pt-4 text-center">
                        <button type="submit" class="w-full sm:w-auto bg-neonYellow hover:bg-neonYellow/90 text-darkBg font-extrabold text-base px-10 py-4 rounded-xl shadow-lg shadow-neonYellow/30 transition-all hover:scale-105">
                            Confirmar Mi Reserva Animatrónica
                        </button>
                    </div>
                </form>

                <!-- Success notification box -->
                <div id="success-msg" class="hidden mt-6 bg-green-950/40 border border-green-500 text-green-400 p-4 rounded-xl text-center text-sm font-semibold">
                    ¡Reserva registrada con éxito! Te esperamos en Bons Burguer. ¡Que disfrutes del show!
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-black py-12 border-t border-gray-900 text-center text-xs text-gray-500 space-y-4 px-4">
        <div class="flex justify-center space-x-6 text-xl text-gray-400 mb-4">
            <a href="#" class="hover:text-neonPurple transition-colors"><i class="fa-brands fa-facebook"></i></a>
            <a href="#" class="hover:text-neonBlue transition-colors"><i class="fa-brands fa-instagram"></i></a>
            <a href="#" class="hover:text-neonYellow transition-colors"><i class="fa-brands fa-tiktok"></i></a>
            <a href="#" class="hover:text-red-500 transition-colors"><i class="fa-brands fa-youtube"></i></a>
        </div>
        
        <p class="max-w-xl mx-auto italic text-gray-400">
            "Bons Burguer no se hace responsable por desapariciones misteriosas de papas fritas después de medianoche ni por sustos repentinos en los pasillos traseros."
        </p>
        
        <p class="pt-4 border-t border-gray-900/50">
            &copy; 2026 Bons Burguer Inc. Todos los derechos reservados. Diseñado para fans de la diversión y el misterio.
        </p>
    </footer>

    <script>
        // Mobile Menu Toggle
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Toggle Animatronic Status
        function toggleStatus(elementId, btn) {
            const badge = document.getElementById(elementId);
            if (badge.classList.contains('bg-green-500/20')) {
                badge.className = 'absolute top-4 left-4 bg-yellow-500/20 border border-yellow-500 text-yellow-400 text-xs font-arcade px-2.5 py-1 rounded-full';
                badge.innerHTML = '⚠ EN MANTENIMIENTO';
                btn.innerText = 'Activar';
            } else {
                badge.className = 'absolute top-4 left-4 bg-green-500/20 border border-green-500 text-green-400 text-xs font-arcade px-2.5 py-1 rounded-full';
                badge.innerHTML = '● ACTIVO';
                btn.innerText = 'Cambiar Estado';
            }
        }

        // Order item simulated action
        function orderItem(itemName) {
            alertCustom('¡Has añadido "' + itemName + '" a tu pedido! Prepárate para el sabor.');
        }

        // Reservation Form submission
        function handleReservation(e) {
            e.preventDefault();
            const name = document.getElementById('res-name').value;
            const successBox = document.getElementById('success-msg');
            successBox.classList.remove('hidden');
            successBox.innerHTML = `¡Fantástico, <strong>${name}</strong>! Tu reserva en Bons Burguer ha sido guardada. Te hemos enviado un comprobante a tu correo.`;
            document.getElementById('reservation-form').reset();
            setTimeout(() => {
                successBox.scrollIntoView({ behavior: 'smooth' });
            }, 100);
        }

        // Custom non-blocking message box simulation instead of native alert
        function alertCustom(message) {
            const existing = document.getElementById('custom-toast');
            if (existing) existing.remove();

            const toast = document.createElement('div');
            toast.id = 'custom-toast';
            toast.className = 'fixed bottom-6 right-6 z-50 bg-cardBg border-2 border-neonYellow text-white px-6 py-4 rounded-2xl shadow-2xl flex items-center space-x-3 animate-bounce';
            toast.innerHTML = `
                <i class="fa-solid fa-burger text-neonYellow text-xl"></i>
                <span class="text-sm font-semibold">${message}</span>
            `;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.5s ease';
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }
    </script>
</body>
</html>
